<?xml version="1.0" encoding="utf-8"?>
<!-- Documents downloaded through the authenticated client land in
     cache/documents and are handed to a viewer via FileProvider. -->
<paths>
    <cache-path name="documents" path="documents/" />
    <!-- Chat attachments of a kind the app cannot show itself (ChatAttachmentCache). -->
    <cache-path name="chat_attachments" path="chat_attachments/" />
</paths>
