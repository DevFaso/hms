### Create Yalgado department as hadmin3
POST http://localhost:8081/api/departments
Authorization: Bearer {{token}}
Content-Type: application/json
Accept-Language: en

{
  "hospitalName": "Sandof Hospital",
  "name": "Surgeon",
  "code": "SURGERY",
  "email": "genmed@yalgado.bf",
  "phoneNumber": "+22670011223",
  "description": "Department of surgery",
  "active": true,
  "translations": [
    {
      "languageCode": "fr",
      "name": "Chirurgie",
      "description": "Département de Chirurgie"
    }
  ]
}

### Option A: filter query
GET http://localhost:8081/api/departments?hospitalName=Yalgado%20Hospital&name=General%20Medicine
Authorization: Bearer {{token}}
Accept-Language: en
###
GET http://localhost:8081/api/departments/by-hospital/Sandof%20Hospital
Authorization: Bearer {{token}}

### link staff to department
PUT http://localhost:8081/api/staff/bad141f5-8796-4196-9019-b242d7cbddea/department/c04a13d5-feb9-486e-9597-b8fbaa58e531
Authorization: Bearer {{token}}
Content-Type: application/json
Accept-Language: en

{
  "userEmail": "doctor@yalgado.bf",
  "hospitalName": "Sandof Hospital",
  "departmentName": "Surgeon",
  "assignmentRef": "Doctor-Surgeon-Sandof",
  "jobTitle": "Doctor",
  "employmentType": "FULL_TIME",
  "specialization": "General Medicine",
  "licenseNumber": "DOC-1234",
  "startDate": "2025-07-23",
  "active": true,
  "name": "DoctorFirst DoctorLast"
}

