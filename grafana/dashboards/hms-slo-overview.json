{
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "loki", "uid": "${loki_ds}" },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "expr": "{application=\"$application\"} |~ \"Started .*Application in [0-9.]+ seconds\"",
        "titleFormat": "Backend started",
        "textFormat": "{{instance}}"
      }
    ]
  },
  "description": "Top-level SLO/SLI view following Google SRE 'multi-window, multi-burn-rate' alerting and the RED method.\nAvailability SLO target = ${slo_target} (define via dashboard variable).\n\nDefinitions:\n  - good = http_server_requests_seconds_count{status!~\"5..\"}\n  - total = http_server_requests_seconds_count\n  - latency SLI = % of requests below ${latency_target}s\n\nBurn-rate alerts fire from Prometheus rules in grafana/rules/alerts.yml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "HMS Dashboards", "asDropdown": true, "includeVars": true, "keepTime": true, "tags": ["hms"], "type": "dashboards", "icon": "external link", "targetBlank": false }
  ],
  "panels": [
    {
      "id": 1,
      "title": "SLO target (availability)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "$slo_target" }]
    },
    {
      "id": 2,
      "title": "Availability (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "1 - (sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1h])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1h])), 0.0001))" }
      ]
    },
    {
      "id": 3,
      "title": "Availability (6h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "1 - (sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[6h])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[6h])), 0.0001))" }
      ]
    },
    {
      "id": 4,
      "title": "Availability (30d)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 5,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "1 - (sum(increase(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_requests_seconds_count{application=\"$application\"}[30d])), 0.0001))" }
      ]
    },
    {
      "id": 5,
      "title": "Error budget remaining (30d)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "green", "value": 0.5 }] }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "1 - ((1 - (sum(increase(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_requests_seconds_count{application=\"$application\"}[30d])), 0.0001))) - $slo_target) / clamp_min(1 - $slo_target, 0.00001) * -1" }
      ]
    },
    {
      "id": 10,
      "title": "Rate (R) — req/s by status class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" }, "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"2..\"}[$__rate_interval]))", "legendFormat": "2xx" },
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"3..\"}[$__rate_interval]))", "legendFormat": "3xx" },
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"4..\"}[$__rate_interval]))", "legendFormat": "4xx" },
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 11,
      "title": "Errors (E) — 5xx ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.005 }, { "color": "red", "value": 0.02 }] }
        }
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[$__rate_interval])), 0.0001)", "legendFormat": "5xx ratio" },
        { "expr": "1 - $slo_target", "legendFormat": "SLO threshold" }
      ]
    },
    {
      "id": 12,
      "title": "Duration (D) — p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[$__rate_interval])) by (le))", "legendFormat": "p99" },
        { "expr": "$latency_target", "legendFormat": "Latency target" }
      ]
    },
    {
      "id": 20,
      "title": "Burn-rate windows (multi-window MWMBR)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14 }] }
        }
      },
      "targets": [
        { "expr": "(sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[5m])), 0.0001)) / clamp_min(1 - $slo_target, 0.00001)", "legendFormat": "5m burn" },
        { "expr": "(sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1h])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1h])), 0.0001)) / clamp_min(1 - $slo_target, 0.00001)", "legendFormat": "1h burn" },
        { "expr": "(sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[6h])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[6h])), 0.0001)) / clamp_min(1 - $slo_target, 0.00001)", "legendFormat": "6h burn" }
      ]
    },
    {
      "id": 21,
      "title": "Latency SLI: % requests under target",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        }
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_bucket{application=\"$application\", le=\"+Inf\"}[$__rate_interval]))", "hide": true, "refId": "TOTAL" },
        { "expr": "(sum(rate(http_server_requests_seconds_bucket{application=\"$application\", le=\"$latency_target\"}[$__rate_interval]))) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\"}[$__rate_interval])), 0.0001)", "legendFormat": "% under ${latency_target}s" }
      ]
    },
    {
      "id": 30,
      "title": "USE: CPU saturation",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] },
          "custom": { "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } }
        }
      },
      "targets": [
        { "expr": "avg(process_cpu_usage{application=\"$application\"})", "legendFormat": "process" },
        { "expr": "avg(system_cpu_usage{application=\"$application\"})", "legendFormat": "system" }
      ]
    },
    {
      "id": 31,
      "title": "USE: Heap saturation",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.75 }, { "color": "red", "value": 0.9 }] },
          "custom": { "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } }
        }
      },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{application=\"$application\", area=\"heap\"}), 1)", "legendFormat": "heap used / max" }
      ]
    },
    {
      "id": 32,
      "title": "USE: DB pool saturation + waits",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        }
      },
      "targets": [
        { "expr": "sum(hikaricp_connections_active{application=\"$application\"}) / clamp_min(sum(hikaricp_connections{application=\"$application\"}), 1)", "legendFormat": "pool utilisation" },
        { "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"$application\"}[$__rate_interval]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count{application=\"$application\"}[$__rate_interval]), 0.0001)", "legendFormat": "avg acquire time {{instance}}" }
      ]
    },
    {
      "id": 40,
      "title": "Top 10 endpoints by 5xx rate",
      "type": "table",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "uri" },
            "properties": [
              {
                "id": "links",
                "value": [
                  { "title": "Drill into endpoint", "url": "/d/hms-api-endpoints/hms-api-endpoint-deep-dive?var-uri=${__value.text}&${__url_time_range}", "targetBlank": false }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "application": true }, "renameByName": { "Value": "5xx_rps" } } }
      ],
      "targets": [
        { "expr": "topk(10, sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1h])) by (uri, method))", "format": "table", "instant": true }
      ]
    },
    {
      "id": 41,
      "title": "Top 10 endpoints by p99 latency",
      "type": "table",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "uri" },
            "properties": [
              {
                "id": "links",
                "value": [
                  { "title": "Drill into endpoint", "url": "/d/hms-api-endpoints/hms-api-endpoint-deep-dive?var-uri=${__value.text}&${__url_time_range}", "targetBlank": false }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "application": true }, "renameByName": { "Value": "p99" } } }
      ],
      "targets": [
        { "expr": "topk(10, histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[15m])) by (le, uri, method)))", "format": "table", "instant": true }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hms", "slo", "sli", "overview", "golden-signals"],
  "templating": {
    "list": [
      { "name": "prometheus_ds", "type": "datasource", "label": "Prometheus", "query": "prometheus", "current": { "text": "Prometheus", "value": "hms-prometheus" } },
      { "name": "loki_ds", "type": "datasource", "label": "Loki", "query": "loki", "current": { "text": "Loki", "value": "hms-loki" } },
      {
        "name": "application", "type": "query", "label": "Application",
        "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "query": { "qryType": 1, "query": "label_values(up, application)" },
        "refresh": 1, "current": { "text": "hms", "value": "hms" }
      },
      {
        "name": "slo_target", "type": "custom", "label": "Availability SLO target",
        "query": "0.99,0.995,0.999,0.9995",
        "current": { "text": "0.999", "value": "0.999" },
        "options": [
          { "text": "0.99 (two 9s)", "value": "0.99", "selected": false },
          { "text": "0.995", "value": "0.995", "selected": false },
          { "text": "0.999 (three 9s)", "value": "0.999", "selected": true },
          { "text": "0.9995", "value": "0.9995", "selected": false }
        ]
      },
      {
        "name": "latency_target", "type": "custom", "label": "Latency target (s)",
        "query": "0.25,0.5,1,2,3",
        "current": { "text": "1", "value": "1" },
        "options": [
          { "text": "0.25", "value": "0.25" },
          { "text": "0.5", "value": "0.5" },
          { "text": "1", "value": "1", "selected": true },
          { "text": "2", "value": "2" },
          { "text": "3", "value": "3" }
        ]
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HMS – SLO & Golden Signals",
  "uid": "hms-slo-overview",
  "version": 1
}
