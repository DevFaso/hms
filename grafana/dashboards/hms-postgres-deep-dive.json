{
  "annotations": { "list": [] },
  "description": "PostgreSQL deep dive — backend connections, query throughput, locks, replication lag, table bloat, cache hit ratio.\nRequires the `observability` compose profile (postgres-exporter container).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "HMS Dashboards", "asDropdown": true, "includeVars": true, "keepTime": true, "tags": ["hms"], "type": "dashboards", "icon": "external link", "targetBlank": false }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Postgres Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "max(pg_up{instance=~\"$instance\"})" }]
    },
    {
      "id": 2,
      "title": "Backends",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends{instance=~\"$instance\", datname!~\"template.*|postgres\"})" }]
    },
    {
      "id": 3,
      "title": "Active backends",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(pg_stat_activity_count{instance=~\"$instance\", state=\"active\"})" }]
    },
    {
      "id": 4,
      "title": "Cache hit ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_blks_hit{instance=~\"$instance\", datname!~\"template.*|postgres\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{instance=~\"$instance\", datname!~\"template.*|postgres\"}[5m]) + rate(pg_stat_database_blks_read{instance=~\"$instance\", datname!~\"template.*|postgres\"}[5m])), 0.0001)" }
      ]
    },
    {
      "id": 5,
      "title": "Deadlocks (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(pg_stat_database_deadlocks{instance=~\"$instance\"}[5m]))" }
      ]
    },
    {
      "id": 6,
      "title": "Replication lag (s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 30 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "max(pg_replication_lag{instance=~\"$instance\"}) OR on() vector(0)" }]
    },
    {
      "id": 10,
      "title": "Connections by state",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 15, "lineWidth": 1 } } },
      "targets": [
        { "expr": "sum by (state) (pg_stat_activity_count{instance=~\"$instance\"})", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 11,
      "title": "Transactions (commits / rollbacks)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit{instance=~\"$instance\", datname!~\"template.*|postgres\"}[$__rate_interval]))", "legendFormat": "commits" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback{instance=~\"$instance\", datname!~\"template.*|postgres\"}[$__rate_interval]))", "legendFormat": "rollbacks" }
      ]
    },
    {
      "id": 12,
      "title": "Tuples — fetched / returned / inserted / updated / deleted",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_fetched{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "fetched" },
        { "expr": "sum(rate(pg_stat_database_tup_returned{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "returned" },
        { "expr": "sum(rate(pg_stat_database_tup_inserted{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "inserted" },
        { "expr": "sum(rate(pg_stat_database_tup_updated{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "updated" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "deleted" }
      ]
    },
    {
      "id": 13,
      "title": "Block I/O — read vs cache hit",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_blks_hit{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "cache hits" },
        { "expr": "sum(rate(pg_stat_database_blks_read{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "disk reads" }
      ]
    },
    {
      "id": 14,
      "title": "Locks held",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "targets": [
        { "expr": "sum by (mode) (pg_locks_count{instance=~\"$instance\"})", "legendFormat": "{{mode}}" }
      ]
    },
    {
      "id": 15,
      "title": "Database size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "pg_database_size_bytes{instance=~\"$instance\", datname!~\"template.*|postgres\"}", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "id": 16,
      "title": "HikariCP — pool occupancy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 15 } } },
      "targets": [
        { "expr": "sum(hikaricp_connections_active{application=\"$application\"})", "legendFormat": "active" },
        { "expr": "sum(hikaricp_connections_idle{application=\"$application\"})", "legendFormat": "idle" },
        { "expr": "sum(hikaricp_connections_pending{application=\"$application\"})", "legendFormat": "pending" },
        { "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"$application\"}[$__rate_interval]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count{application=\"$application\"}[$__rate_interval]), 0.0001)", "legendFormat": "avg acquire (s)" },
        { "expr": "rate(hikaricp_connections_timeout_total{application=\"$application\"}[$__rate_interval])", "legendFormat": "timeout rate" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hms", "postgres", "database"],
  "templating": {
    "list": [
      { "name": "prometheus_ds", "type": "datasource", "label": "Prometheus", "query": "prometheus", "current": { "text": "Prometheus", "value": "hms-prometheus" } },
      {
        "name": "application", "type": "query", "label": "Application",
        "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "query": { "qryType": 1, "query": "label_values(up, application)" },
        "refresh": 1, "current": { "text": "hms", "value": "hms" }
      },
      {
        "name": "instance", "type": "query", "label": "Postgres instance",
        "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "query": { "qryType": 1, "query": "label_values(pg_up, instance)" },
        "refresh": 2, "current": { "text": "All", "value": ".*" }, "includeAll": true, "allValue": ".*", "multi": true, "sort": 1
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HMS – PostgreSQL Deep Dive",
  "uid": "hms-postgres",
  "version": 1
}
