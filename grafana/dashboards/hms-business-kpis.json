{
  "annotations": { "list": [] },
  "description": "Hospital Management System – Business & Clinical KPIs.\nFilter by application via the variable above. All rate windows respect $__rate_interval.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "HMS Dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": ["hms"],
      "type": "dashboards",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Total requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"$application\"}[24h]))" }
      ]
    },
    {
      "id": 2,
      "title": "Login attempts (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"$application\", uri=~\"/auth/login.*|/login.*\"}[24h]))" }
      ]
    },
    {
      "id": 3,
      "title": "Login failures (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"$application\", uri=~\"/auth/login.*|/login.*\", status=~\"401|403\"}[24h]))" }
      ]
    },
    {
      "id": 4,
      "title": "Patient writes (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"$application\", uri=~\"/patients.*\", method=~\"POST|PUT|PATCH\"}[24h]))" }
      ]
    },
    {
      "id": 5,
      "title": "Appointments booked (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"$application\", uri=~\"/appointments.*\", method=\"POST\", status=~\"2..\"}[24h]))" }
      ]
    },
    {
      "id": 6,
      "title": "Lab orders placed (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"$application\", uri=~\"/lab-orders.*|/laborders.*\", method=\"POST\", status=~\"2..\"}[24h]))" }
      ]
    },
    {
      "id": 10,
      "title": "API Requests by Endpoint (Top 10, 24h)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "displayMode": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "uri" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drill into endpoint",
                    "url": "/d/hms-api-endpoints/hms-api-endpoint-deep-dive?var-uri=${__value.text}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "application": true }, "renameByName": { "Value": "requests" } } }
      ],
      "targets": [
        { "expr": "topk(10, sum(increase(http_server_requests_seconds_count{application=\"$application\"}[24h])) by (uri))", "format": "table", "instant": true }
      ]
    },
    {
      "id": 11,
      "title": "Authentication Events (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "reqpm" } },
      "targets": [
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/auth/login.*|/login.*\"}[$__rate_interval])) by (status)", "legendFormat": "login {{status}}" },
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/auth/logout.*|/logout.*\"}[$__rate_interval])) by (status)", "legendFormat": "logout {{status}}" },
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/auth/refresh.*|/refresh.*\"}[$__rate_interval])) by (status)", "legendFormat": "refresh {{status}}" }
      ]
    },
    {
      "id": 12,
      "title": "Patient Operations (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "reqpm" } },
      "targets": [
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/patients.*\"}[$__rate_interval])) by (method)", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 13,
      "title": "Appointment Operations (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "reqpm" } },
      "targets": [
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/appointments.*\"}[$__rate_interval])) by (method)", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 14,
      "title": "Encounter & Billing (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "reqpm" } },
      "targets": [
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/encounters.*\"}[$__rate_interval]))", "legendFormat": "encounters" },
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/billing.*|/invoices.*|/pharmacy/payments.*|/pharmacy/claims.*\"}[$__rate_interval]))", "legendFormat": "billing+pharmacy" }
      ]
    },
    {
      "id": 15,
      "title": "Lab & Imaging Orders (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": { "defaults": { "unit": "reqpm" } },
      "targets": [
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/lab-orders.*|/laborders.*\"}[$__rate_interval]))", "legendFormat": "lab orders" },
        { "expr": "60 * sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/imaging-orders.*|/imagingorders.*\"}[$__rate_interval]))", "legendFormat": "imaging orders" }
      ]
    },
    {
      "id": 16,
      "title": "Slowest Endpoints (p99 latency, last 15m)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "uri" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drill into endpoint",
                    "url": "/d/hms-api-endpoints/hms-api-endpoint-deep-dive?var-uri=${__value.text}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "application": true }, "renameByName": { "Value": "p99" } } }
      ],
      "targets": [
        { "expr": "topk(15, histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[15m])) by (le, uri, method)))", "format": "table", "instant": true }
      ]
    },
    {
      "id": 17,
      "title": "Recent Auth Failures",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        { "expr": "{application=\"$application\"} |~ \"(?i)(JWT|WS-TICKET|Auth).*(invalid|expired|unauthor|disabled|missing)\"", "refId": "A" }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["hms", "business-kpi", "loki"],
  "templating": {
    "list": [
      {
        "name": "prometheus_ds",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "hms-prometheus" }
      },
      {
        "name": "loki_ds",
        "type": "datasource",
        "label": "Loki",
        "query": "loki",
        "current": { "text": "Loki", "value": "hms-loki" }
      },
      {
        "name": "application",
        "type": "query",
        "label": "Application",
        "datasource": { "type": "prometheus", "uid": "${prometheus_ds}" },
        "query": { "qryType": 1, "query": "label_values(up, application)" },
        "refresh": 1,
        "current": { "text": "hms", "value": "hms" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HMS – Business KPIs",
  "uid": "hms-business-kpi",
  "version": 3
}
