# ─── Railway Project (MediHub) ───
RAILWAY_PROJECT_ID=bc9920fa-8753-434c-b812-3fc4b5473542
# Tokens per environment (set these in GitHub Secrets, not here)
# HMS_DEV_TOKEN=  → GitHub Secret
# HMS_UAT_TOKEN=  → GitHub Secret
# HMS_PROD_TOKEN= → GitHub Secret

# ─── Database (Railway provides DATABASE_URL automatically) ───
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hospital_db
SPRING_DATASOURCE_USERNAME=hospital_user
SPRING_DATASOURCE_PASSWORD=hospital_pass

# ─── JWT Security ───
APP_JWTSECRET=change-me-to-a-256-bit-secret
APP_JWTEXPIRATION_MS=86400000

# ─── Bootstrap (first admin signup) ───
APP_BOOTSTRAP_TOKEN=change-me

# ─── Spring Profile ───
SPRING_PROFILES_ACTIVE=dev

# ─── Port (Railway sets this automatically) ───
PORT=8081

# ─── AWS S3 (optional) ───
AWS_S3_ACCESSKEY=
AWS_S3_SECRETKEY=
AWS_S3_BUCKETNAME=

# ─── CORS & Domains ───
# Dev:  Frontend=https://hms.dev.bitnesttechs.com  API=https://api.hms.dev.bitnesttechs.com
# UAT:  Frontend=https://hms.uat.bitnesttechs.com  API=https://api.hms.uat.bitnesttechs.com
# Prod: Frontend=https://hms.bitnesttechs.com      API=https://api.hms.bitnesttechs.com
CORS_ALLOWED_ORIGINS=http://localhost:4200
BACKEND_BASE_URL=http://localhost:8081

# ─── Mail (optional) ───
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ─── Grafana Cloud Observability (optional) ───
# Set these on Railway to enable OTEL auto-instrumentation + Grafana Cloud export.
# Leave empty to disable (local dev uses docker-compose Prometheus/Grafana instead).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceId:token)>
OTEL_SERVICE_NAME=hms-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=hms
OTEL_METRICS_ENABLED=true
# Micrometer OTLP auth header (same credentials, different format)
GRAFANA_OTLP_AUTH_HEADER=Basic <base64(instanceId:token)>

# ─── Splunk HEC log shipping (optional, additive to Grafana Cloud) ───
# When SPLUNK_HEC_ENABLED=true the backend POSTs every Logback event as a JSON envelope
# to the configured HEC endpoint. URL must be HTTPS in any non-local environment;
# SplunkLoggingProperties enforces that at startup. Leave SPLUNK_HEC_ENABLED=false
# (the default) for local dev — the appender becomes a no-op.
SPLUNK_HEC_ENABLED=false
SPLUNK_HEC_URL=https://splunk-hec.example.com:8088
SPLUNK_HEC_TOKEN=<HEC token from Splunk → Settings → Data inputs → HTTP Event Collector>
SPLUNK_HEC_INDEX=hms_dev
SPLUNK_HEC_SOURCE=hms-backend
SPLUNK_HEC_SOURCETYPE=spring-boot:json
# Optional: override the host field. Defaults to the container hostname when blank.
SPLUNK_HEC_HOST=
# LOCAL DEV ONLY — lets the appender accept a plain-HTTP URL (e.g. an HTTP mock).
# MUST NOT be set in UAT/prod; SplunkLoggingProperties enforces HTTPS otherwise.
SPLUNK_HEC_ALLOW_INSECURE_URL=false

# ─── Keycloak (local dev — `docker compose --profile keycloak up`) ───
# Bootstrap admin for the local Keycloak admin console at http://localhost:8081/admin.
# The defaults baked into docker-compose.yml are admin/admin and are only safe
# on a single-developer machine that is not exposed on a shared network.
# Override locally by copying this file to `.env` (gitignored) and changing the password.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally

# ─── Keycloak / OIDC resource server (KC-5) ───
# When OIDC_ISSUER_URI is set, the backend becomes an OAuth2 Resource Server
# that ALSO accepts Keycloak-issued JWTs alongside its own internal tokens.
# Both stacks coexist during the cutover soak. See
# docs/runbooks/keycloak-cutover-runbook.md for the procedure.
OIDC_ISSUER_URI=
OIDC_AUDIENCE=hms-backend

# OIDC_REQUIRED gates Phase C cutover (roadmap row 8). When `true`, the legacy
# username/password endpoints (POST /auth/login + POST /auth/token/refresh)
# return HTTP 410 Gone with a `Link: rel="oauth2-issuer"` header pointing at
# OIDC_ISSUER_URI so clients can self-discover the SSO endpoint. Already-
# issued internal tokens keep validating until they expire (≤ 15 min) — no
# in-flight session is killed. Default `false` preserves today's behaviour;
# flip to `true` in UAT first, soak ≥ 5 business days, then promote to prod.
OIDC_REQUIRED=false
