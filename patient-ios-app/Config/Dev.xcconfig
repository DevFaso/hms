// Per-env Keycloak settings for the `Release-Dev` build configuration.
//
// Selected by `xcodebuild -configuration Release-Dev` for TestFlight
// internal builds pointing at `hms-keycloak-dev`. The values below get
// substituted into Info.plist (via `$(VAR)` keys) and read at runtime by
// `KeycloakConfig` / `FeatureFlags`. See `Config/README.md` for the full
// matrix.

// The dev API is same-origin on the portal host; `api.dev.e-keneya.com`
// does not resolve. Slashes are escaped because xcconfig treats `//` as
// a comment.
MEDIHUB_API_BASE_URL = https:/$()/dev.e-keneya.com/api
// Escaped like the API URL: an unescaped `//` starts an xcconfig comment,
// which left the issuer as just "https:".
MEDIHUB_KEYCLOAK_ISSUER = https:/$()/hms-keycloak-dev.up.railway.app/realms/hms
// Was 1, turned off because an SSO session had no HMS user id and the
// Messages tab reported "not signed in". The app side is fixed: every login
// path, SSO included, now resolves and persists the id from
// /auth/session/bootstrap before the session opens. Still 0 until someone has
// signed in with SSO on a TestFlight build and seen chat work against the dev
// realm (the Keycloak token must carry the patient role CHAT_ROLES checks);
// that end-to-end check has not been made, so flipping this is a product call.
MEDIHUB_KEYCLOAK_SSO_ENABLED = 0
MEDIHUB_KEYCLOAK_CLIENT_ID = hms-patient-ios
MEDIHUB_KEYCLOAK_REDIRECT_URI = com.bitnesttechs.hms.patient.native:/oauth2redirect
