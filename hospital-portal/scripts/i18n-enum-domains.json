  "signatureStatus": { "enum": "hospital-core/src/main/java/com/example/hms/enums/SignatureStatus.java" },
  "status": {
    "reason": "the generic domain: 24 call sites render whatever status their own DTO carries, so there is no one enum to check"
  },
  "taskPriority": {
    "reason": "shared by nurse tasks and in-basket items, which have separate priority vocabularies"
  },
  "treatmentPlanStatus": { "enum": "hospital-core/src/main/java/com/example/hms/enums/TreatmentPlanStatus.java" },
  "treatmentPlanTaskStatus": { "enum": "hospital-core/src/main/java/com/example/hms/enums/TreatmentPlanTaskStatus.java" },
  "vitalSource": {
