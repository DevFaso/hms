{
  "name": "hospital-portal",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test --watch=false --browsers=ChromeHeadless",
    "test:coverage": "ng test --watch=false --code-coverage --browsers=ChromeHeadless",
    "test:ci": "CI=1 ng test --watch=false --code-coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "coverage:report": "node scripts/check-coverage.mjs --report-only",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test a11y.spec.ts",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier \"src/**/*.{ts,html,scss,md,json}\" --write",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,md,json}\"",
    "i18n:check": "node scripts/check-i18n-coverage.mjs",
    "i18n:parity": "node scripts/check-i18n-coverage.mjs --strict",
    "i18n:referenced": "node scripts/check-i18n-referenced-keys.mjs",
    "i18n:translated": "node scripts/check-i18n-untranslated.mjs",
    "i18n:enums": "node scripts/check-i18n-enum-coverage.mjs",
    "i18n:raw-enums": "node scripts/check-i18n-raw-enums.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "i18n:report": "node scripts/check-i18n-coverage.mjs --report-only"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "overrides": {
    "body-parser": "2.3.0",
    "tar": "7.5.22",
    "qs": "6.15.2",
    "yauzl": "3.2.1",
    "vite": {
      ".": "7.3.5",
      "esbuild": "^0.28.1"
    }
  },
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.7",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/platform-server": "22.1.6",
    "@angular/router": "22.1.6",
    "@angular/ssr": "^22.1.8",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@stomp/stompjs": "^7.3.0",
    "angular-oauth2-oidc": "^22.0.2",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "sockjs-client": "1.6.1",
    "tslib": "2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "6.0.0",
    "@types/node": "^24.13.4",
    "@types/sockjs-client": "^1.5.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.9.0",
    "jspdf": "^4.2.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.9.9",
    "puppeteer": "^25.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
